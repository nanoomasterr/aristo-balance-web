# ========================================================
# .gitignore - Aristo Balance Therapy Center Web App
# ========================================================

# 1. Dependensi Node.js (Folder besar yang di-install via npm/yarn)
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 2. Folder Cache & Output Build Next.js
/.next/
/out/
/build/
/coverage/
*.tsbuildinfo
next-env.d.ts

# 3. Kredensial Rahasia & Environment Variables (JANGAN DI-PUSH KE GITHUB)
.env*
!.env.example

# 4. Folder Deployment Lokal Vercel
.vercel/

# 5. File Log & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 6. File Sistem Operasi
.DS_Store
Thumbs.db
*.pem

